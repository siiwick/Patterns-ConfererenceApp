<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="patterns.lia.controller.AdminDashboardController">
   <top>
      <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="%admin.title">
                     <font>
                        <Font name="Franklin Gothic Medium Cond" size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label fx:id="usernameLabel" text="Username" />
            <HBox alignment="CENTER_RIGHT" spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button minWidth="82.0" mnemonicParsing="false" onAction="#logout" prefHeight="26.0" text="%button.logout" />
                  <Button minWidth="46.0" mnemonicParsing="false" onAction="#exit" prefHeight="26.0" text="%button.exit" />
                  <Hyperlink onAction="#switchLanguage" text="%language.switch" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <TabPane fx:id="tabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab text="%admin.tab.conferences">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
          <Tab text="%admin.tab.reports">
            <content>
                  <VBox alignment="TOP_CENTER" spacing="15.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <HBox spacing="40.0" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold;" text="%reports.list.title" />
                                    <ListView fx:id="reportList" prefHeight="200.0" prefWidth="240.0" />
                                 </children>
                              </VBox>
                              <VBox fx:id="reportDetails" alignment="CENTER" spacing="10.0" style="-fx-border-color: #b5b5b5; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                                 <children>
                                    <Label fx:id="reportDetailsLabel" text="%reports.details.placeholder" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Label fx:id="feedbackLabel" />
                        <Button minWidth="110.0" mnemonicParsing="false" onAction="#backToMenu" text="%reports.back" />
                     </children>
                  </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>
