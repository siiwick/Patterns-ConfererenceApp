<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="patterns.lia.controller.CreateAccountController">
   <children>
      <Label text="Create Account" textAlignment="CENTER">
         <padding>
            <Insets bottom="20.0" />
         </padding>
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox>
         <children>
            <Label minWidth="60.0" text="First Name:" />
            <TextField fx:id="firstNameField" style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <VBox>
         <children>
            <Label minWidth="60.0" text="Last Name:" />
            <TextField fx:id="lastNameField" style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <VBox>
         <children>
            <Label minWidth="60.0" text="Age:" />
            <Spinner fx:id="ageSpinner" editable="true" prefHeight="26.0" prefWidth="200.0" />
         </children>
      </VBox>
      <Separator prefWidth="200.0" />
      <VBox>
         <children>
            <Label minWidth="60.0" text="Email:" />
            <TextField fx:id="emailField" promptText="you@example.com" style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <VBox>
         <children>
            <Label minWidth="60.0" text="Password:" />
            <PasswordField fx:id="passwordField" style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <VBox>
         <children>
            <Label minWidth="60.0" text="Confirm Password:" />
            <PasswordField fx:id="confirmPasswordField" style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <Label fx:id="errorLabel" style="-fx-text-fill: #c62828;" wrapText="true" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" defaultButton="true" onAction="#createAccount" prefHeight="41.0" prefWidth="112.0" style="-fx-border-radius: 100;" text="Create Account" />
            <Button mnemonicParsing="false" onAction="#exit" prefHeight="41.0" prefWidth="73.0" style="-fx-border-radius: 100;" text="Exit" />
         </children>
         <padding>
            <Insets top="20.0" />
         </padding>
      </HBox>
      <Hyperlink onAction="#backToLogin" text="Already have an account? Log in" textAlignment="CENTER" />
      <Hyperlink text="🌐 Language" textAlignment="CENTER" />
   </children>
   <padding>
      <Insets bottom="20.0" left="80.0" right="80.0" top="40.0" />
   </padding>
</VBox>
