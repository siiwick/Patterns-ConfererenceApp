<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="patterns.lia.controller.LoginController">
   <children>
      <Label text="Login">
         <padding>
            <Insets bottom="20.0" />
         </padding>
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox>
         <children>
            <Label minWidth="60.0" text="Username:" />
            <TextField style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <VBox>
         <children>
            <Label minWidth="60.0" text="Password:" />
            <TextField style="-fx-border-radius: 100;" />
         </children>
      </VBox>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="112.0" style="-fx-border-radius: 100;" text="Login" />
            <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="73.0" style="-fx-border-radius: 100;" text="Exit" />
         </children>
         <padding>
            <Insets top="20.0" />
         </padding>
      </HBox>
      <Hyperlink text="🌐 Language" textAlignment="CENTER" />
   </children>
   <padding>
      <Insets bottom="20.0" left="80.0" right="80.0" top="40.0" />
   </padding>
</VBox>
