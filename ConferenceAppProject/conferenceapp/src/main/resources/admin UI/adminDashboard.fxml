                  <Button mnemonicParsing="false" onAction="#logout" prefHeight="26.0" prefWidth="82.0" text="Logout" />
                  <Button mnemonicParsing="false" onAction="#exit" prefHeight="26.0" prefWidth="46.0" text="Exit" />
